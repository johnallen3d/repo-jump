{
  "manifest_version": 3,
  "name": "Repo Jump",
  "version": "0.1.0",
  "description": "Keyboard-first fuzzy search over your GitHub repos. Jump straight to PRs, issues, actions, and more.",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "gh"
  },
  "action": {
    "default_title": "Repo Jump",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "description": "Open the Repo Jump palette (toolbar popup)"
    }
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "lib/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
